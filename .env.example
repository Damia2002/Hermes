# ─────────────────────────────────────────────
#  HERMES — Environment Configuration Template
#  Copy to .env and fill in real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────

# ── LLM Models ───────────────────────────────
# Set PRIMARY_LLM and FAST_LLM to any model below.
# Only the API key matching your chosen provider is required.
#
# Provider    | Model string                                              | Key needed
# ------------|-----------------------------------------------------------|------------------
# Groq        | groq/llama-3.3-70b-versatile                             | GROQ_API_KEY
# Cerebras    | cerebras/llama-3.3-70b                                   | CEREBRAS_API_KEY
# Together AI | together_ai/meta-llama/Meta-Llama-3.3-70B-Instruct-Turbo | TOGETHER_API_KEY
# OpenRouter  | openrouter/meta-llama/llama-3.3-70b-instruct:free        | OPENROUTER_API_KEY
# Gemini      | gemini/gemini-2.0-flash                                  | GEMINI_API_KEY
# Mistral     | mistral/mistral-small-latest                             | MISTRAL_API_KEY

PRIMARY_LLM=groq/llama-3.3-70b-versatile
FAST_LLM=groq/llama-3.3-70b-versatile

# ── LLM API Keys (fill in the one you use) ───
GROQ_API_KEY=your_groq_api_key_here
# CEREBRAS_API_KEY=your_cerebras_api_key_here
# TOGETHER_API_KEY=your_together_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# MISTRAL_API_KEY=your_mistral_api_key_here

# ── Embedding and Reranking ───────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Optional heavier reranker for ablation:
# RERANKER_MODEL=BAAI/bge-reranker-base

# ── Vector Database ───────────────────────────
QDRANT_MODE=local
QDRANT_PATH=./storage/qdrant
QDRANT_COLLECTION=hermes_docs

# ── Application Database ──────────────────────
DATABASE_URL=sqlite+aiosqlite:///./storage/hermes.db

# ── Dataset ───────────────────────────────────
# Profile: small | medium | full
DATASET_PROFILE=medium
# HuggingFace dataset identifier
HF_DATASET_ID=onyx-dot-app/EnterpriseRAG-Bench
# Optional HuggingFace token (for gated repos)
# HF_TOKEN=your_huggingface_token

# ── Retrieval Settings ────────────────────────
EMBEDDING_BATCH_SIZE=16
INDEX_WRITE_BATCH_SIZE=100
MAX_CHUNK_TOKENS=400
CHUNK_OVERLAP_TOKENS=50
MAX_RETRIEVED_DOCUMENTS=50
MAX_RERANKED_DOCUMENTS=10
MAX_LLM_CONTEXT_DOCUMENTS=8

# ── Agent Limits ──────────────────────────────
MAX_AGENT_ITERATIONS=5
MAX_TOOL_CALLS=10

# ── Reliability ───────────────────────────────
RETRIEVAL_TIMEOUT_SECONDS=10
TOOL_TIMEOUT_SECONDS=20
LLM_TIMEOUT_SECONDS=60
WORKFLOW_TIMEOUT_SECONDS=120
MAX_RETRIES=3

# ── Observability ─────────────────────────────
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com
# Set to false to run without Langfuse
LANGFUSE_ENABLED=true

LOG_LEVEL=INFO
LOG_DIR=./storage/logs

# ── API Server ────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
SECRET_KEY=change_this_to_a_random_secret_for_jwt

# ── Streamlit ─────────────────────────────────
STREAMLIT_PORT=8501
